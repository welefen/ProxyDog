<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Copy this file to Support/AppConfig.plist and fill in your Aptabase App Key.
	     The file is gitignored: the key is injected into the built app at build time
	     and is never asked from end users. Leave the value empty to disable analytics. -->
	<key>AptabaseAppKey</key>
	<string></string>
</dict>
</plist>
