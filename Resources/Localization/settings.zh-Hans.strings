/* Settings and onboarding copy: 简体中文. */

/* Settings · sections */
"Connection" = "连接";
"Appearance" = "外观";
"Certificate" = "证书";

/* Settings · connection */
"Proxy port" = "代理端口";
"Ignore own requests" = "忽略自身请求";
"Keeps ProxyDog's own analytics and update traffic out of the request list." = "ProxyDog 自身的数据埋点、更新检查等请求不会出现在抓包列表里。";
"Changing the port restarts the proxy when it is running." = "修改端口后，代理将在运行状态下自动重启。";
"Restart proxy" = "重启代理";
"SSL proxying" = "SSL 解密";
"Decrypts HTTPS traffic with the ProxyDog root certificate, for both the HTTP and SOCKS5 listeners." = "使用 ProxyDog 根证书解密 HTTPS 流量，对 HTTP 与 SOCKS5 监听端口同时生效。";
"HTTP proxy" = "HTTP 代理";
"System proxy" = "系统代理";
"Routes this Mac's HTTP and HTTPS traffic through ProxyDog." = "将本机的 HTTP 和 HTTPS 流量转发到 ProxyDog。";
"Start the proxy to change this." = "启动代理后才能修改。";
"Upstream proxy" = "上游代理";
"Sends outbound traffic through an existing HTTP proxy such as a VPN client. ProxyDog still captures and decrypts." = "通过已有的 HTTP / SOCKS5 代理（例如 VPN 客户端）出站；ProxyDog 仍然负责抓包与解密。";
"Upstream address" = "上游地址";
"Fill from system proxy" = "从系统代理填入";
"Enter the host of the upstream proxy." = "请输入上游代理的主机地址。";
"The upstream proxy cannot be ProxyDog itself." = "上游代理不能指向 ProxyDog 自身。";

"Upstream protocol" = "上游协议";
"Both addresses are stored; the selected protocol is used." = "两个地址都会保存，实际使用所选协议。";
"HTTP upstream" = "HTTP 上游";
"SOCKS5 upstream" = "SOCKS5 上游";

"HTTP upstream proxy" = "HTTP 上游代理";
"Chains outbound traffic through an existing HTTP proxy such as a VPN client. Only affects traffic entering through the HTTP proxy port." = "通过已有的 HTTP 代理出站（例如 VPN 客户端），仅影响从 HTTP 代理端口进入的流量。";
"SOCKS5 upstream proxy" = "SOCKS5 上游代理";
"Chains traffic from the SOCKS5 listener through an existing SOCKS5 proxy. Only affects traffic entering through the SOCKS5 listener port." = "通过已有的 SOCKS5 代理出站，仅影响从 SOCKS5 监听端口进入的流量。";

"SOCKS5 proxy" = "SOCKS5 代理";
"For apps that only speak SOCKS5, e.g. Telegram. ProxyDog captures and decrypts the traffic the same way." = "给只支持 SOCKS5 的 App 使用，例如 Telegram；ProxyDog 同样会抓包并解密 HTTPS。";
"SOCKS5 port" = "SOCKS5 端口";
"The SOCKS5 port must differ from the HTTP proxy port." = "SOCKS5 端口必须与 HTTP 代理端口不同。";
"The SOCKS5 port must differ from the upstream proxy port." = "SOCKS5 端口必须与上游代理端口不同。";

"Proxy status" = "代理状态";
"Listens on the loopback interface only." = "仅监听本机回环地址。";
"Stopped" = "已停止";
"Starting" = "启动中";
"Failed" = "启动失败";
"Running on %@" = "正在监听 %@";

