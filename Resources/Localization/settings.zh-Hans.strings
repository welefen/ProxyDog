"Add rule" = "添加规则";
"No rules yet" = "还没有规则";
"Add a rule to redirect requests or patch request and response bodies." = "添加规则即可重定向请求，或修改请求与响应内容。";
"Edit rule" = "编辑规则";
"Delete rule" = "删除规则";
"New rule" = "新建规则";
"Enabled" = "启用";
"Name" = "名称";
"Empty matches any method." = "留空表示匹配任意方法。";
"URL pattern" = "URL 模式";
"Matched against the full URL; regular expression or plain text." = "匹配完整 URL，可使用正则表达式或普通文本。";
"Action" = "动作";
"Redirect URL" = "重定向地址";
"Absolute URL to send the request to." = "请求将被重定向到的完整地址。";
"Replacement body" = "替换内容";
"Find" = "查找";
"Replace" = "替换";
"Regular expression; plain text is replaced literally." = "支持正则表达式；普通文本按字面替换。";
"Status code" = "状态码";
"Save" = "保存";
"Cancel" = "取消";
"Enter a URL pattern." = "请输入 URL 模式。";
"Enter a redirect URL." = "请输入重定向地址。";
"Enter a replacement body." = "请输入替换内容。";
"Enter the text to find." = "请输入要查找的文本。";
"Enter a valid status code." = "请输入有效的状态码。";

/* Rewrite actions */
"Redirect" = "重定向";
"Replace request" = "替换请求";
"Replace response" = "替换响应";
"Modify request" = "修改请求";
"Modify response" = "修改响应";

/* Settings · breakpoints */
"Breakpoints" = "断点";
"Matching exchanges pause and open an editor so you can tweak the body before resuming or dropping. Only applies while the proxy is running." = "命中规则的请求会暂停，弹出编辑器供你临时修改正文，改完放行或丢弃。仅在代理运行时生效。";
"Add breakpoint" = "添加断点";
"No breakpoints yet" = "还没有断点规则";
"Add a breakpoint to pause matching requests or responses." = "添加断点即可在匹配的请求或响应处暂停。";
"Edit breakpoint" = "编辑断点";
"Delete breakpoint" = "删除断点";
"New breakpoint" = "新建断点";
"Pause on request" = "在请求阶段暂停";
"Pause on response" = "在响应阶段暂停";
"Select at least one phase." = "请至少选择一个阶段。";

/* Settings · appearance */
"Theme" = "主题";
"Follows the system appearance by default." = "默认跟随系统外观。";
"The app restarts to apply the language change." = "切换语言后应用会自动重启。";

/* Settings · certificate */
"Root certificate" = "根证书";
"Required to inspect HTTPS. Stored in your login keychain." = "用于检查 HTTPS 流量，保存在登录钥匙串中。";
"Trusted" = "受信任";
"Not trusted" = "未受信任";
"Remove certificate trust" = "移除信任";
"Install root certificate" = "安装根证书";
"Refresh certificate" = "刷新证书";
"Export root certificate" = "导出根证书";

/* Settings · analytics */

/* Onboarding · welcome */
"Welcome to ProxyDog" = "欢迎使用 ProxyDog";
"Local HTTPS interception through a root certificate" = "通过根证书在本地解密 HTTPS";
"Captured traffic stays on this Mac" = "抓取到的流量仅保留在本机";
"Copy as curl or export as HAR" = "可复制为 curl 或导出 HAR";

/* Onboarding · certificate */
"Trust the root certificate" = "信任根证书";
"ProxyDog decrypts HTTPS with a local root certificate. macOS has to trust it before encrypted traffic can be inspected." = "ProxyDog 使用本地根证书解密 HTTPS。需先在 macOS 中信任该证书，才能检查加密流量。";
"You can remove the certificate at any time in Settings." = "之后可随时在设置中移除该证书。";

/* Onboarding · ready */
"Get started" = "开始使用";

"Proxy address" = "代理地址";
"Copy proxy address" = "复制代理地址";
"HTTPS traffic stays encrypted until the root certificate is trusted." = "未信任根证书前，HTTPS 流量将保持加密。";
"The proxy starts automatically when ProxyDog launches." = "代理会在 ProxyDog 启动时自动开启。";

/* Onboarding · chrome and actions */
"Close setup" = "关闭引导";
"Done" = "完成";

/* Tabs */
"Rules" = "规则";

/* Certificate warning */
"The root certificate is not installed or trusted, so HTTPS decryption is unavailable. Install the root certificate first." = "根证书尚未安装或未被信任，无法开启 HTTPS 解密。请先安装根证书。";

/* Sections */
"SSL & Certificate" = "SSL 与证书";

/* Certificate actions */
"Export the root certificate file for other devices" = "导出根证书文件（可安装到 iPhone 等其它设备）";

/* Upstream hint */
"Sends outbound traffic through an existing proxy such as a VPN client. The HTTP address is used when filled, otherwise SOCKS5; ProxyDog still captures and decrypts." = "通过已有的 HTTP 或 SOCKS5 代理（例如 VPN 客户端）出站；填写了 HTTP 上游就优先用它，否则使用 SOCKS5 上游。ProxyDog 仍然负责抓包与解密。";

/* Upstream hint */
"Sends outbound traffic through an existing proxy such as a VPN client. Traffic from the HTTP proxy uses the HTTP address, traffic from the SOCKS5 listener uses the SOCKS5 address; when only one is filled both use it." = "通过已有的 HTTP 或 SOCKS5 代理（例如 VPN 客户端）出站：HTTP 入口使用 HTTP 上游地址，SOCKS5 入口使用 SOCKS5 上游地址；只填写一个时两个入口都用它。";
