/* Settings and onboarding copy: 简体中文. */

/* Settings · sections */
"Connection" = "连接";
"Appearance" = "外观";
"Certificate" = "证书";

/* Settings · connection */
"Proxy port" = "代理端口";
"Changing the port restarts the proxy when it is running." = "修改端口后，代理将在运行状态下自动重启。";
"Restart proxy" = "重启代理";
"SSL proxying" = "SSL 解密";
"Decrypts HTTPS traffic with the ProxyDog root certificate." = "使用 ProxyDog 根证书解密 HTTPS 流量。";
"System proxy" = "系统代理";
"Routes this Mac's HTTP and HTTPS traffic through ProxyDog." = "将本机的 HTTP 和 HTTPS 流量转发到 ProxyDog。";
"Start the proxy to change this." = "启动代理后才能修改。";
"Upstream proxy" = "上游代理";
"Sends outbound traffic through an existing HTTP proxy such as a VPN client. ProxyDog still captures and decrypts." = "通过已有的 HTTP / SOCKS5 代理（例如 VPN 客户端）出站；ProxyDog 仍然负责抓包与解密。";
"Upstream address" = "上游地址";
"Fill from system proxy" = "从系统代理填入";
"Enter the host of the upstream proxy." = "请输入上游代理的主机地址。";
"The upstream proxy cannot be ProxyDog itself." = "上游代理不能指向 ProxyDog 自身。";

"SOCKS5 proxy" = "SOCKS5 代理";
"For apps that only speak SOCKS5, e.g. Telegram. ProxyDog captures and decrypts the traffic the same way." = "给只支持 SOCKS5 的 App 使用，例如 Telegram；ProxyDog 同样会抓包并解密 HTTPS。";
"SOCKS5 port" = "SOCKS5 端口";
"The SOCKS5 port must differ from the HTTP proxy port." = "SOCKS5 端口必须与 HTTP 代理端口不同。";
"The SOCKS5 port must differ from the upstream proxy port." = "SOCKS5 端口必须与上游代理端口不同。";

"Proxy status" = "代理状态";
"Listens on the loopback interface only." = "仅监听本机回环地址。";
"Stopped" = "已停止";
"Starting" = "启动中";
"Failed" = "启动失败";
"Running on %@" = "正在监听 %@";

/* Settings · appearance */
"Theme" = "主题";
"Follows the system appearance by default." = "默认跟随系统外观。";
"The app restarts to apply the language change." = "切换语言后应用会自动重启。";

/* Settings · certificate */
"Root certificate" = "根证书";
"Required to inspect HTTPS. Stored in your login keychain." = "用于检查 HTTPS 流量，保存在登录钥匙串中。";
"Trusted" = "受信任";
"Not trusted" = "未受信任";
"Remove certificate trust" = "移除信任";
"Install root certificate" = "安装根证书";
"Refresh certificate" = "刷新证书";
"Export root certificate" = "导出根证书";

